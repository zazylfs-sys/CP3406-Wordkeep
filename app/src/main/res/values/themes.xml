<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Wordkeep" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
    </style>

    <!-- Splash screen (core-splashscreen) shown while the first frame and settings load. -->
    <style name="Theme.Wordkeep.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Wordkeep</item>
    </style>
</resources>
